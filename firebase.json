{
  "firestore": [
    {
      "database": "sudoku-pokemon",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json"
    }
  ],
  "hosting": {
    "target": "games",
    "public": "public-deploy",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/sudoku-pokemon/**",
        "destination": "/sudoku-pokemon/index.html"
      }
    ]
  }
}
